/*
 * moNa2 (右手トラックボール) — DYA Studio 対応 keymap
 *
 * 2026-10-12 時点で実機 (DYA Studio から読み出した値) と同一になるよう固定している。
 *  - キー割り当て: 11 レイヤー × 42 キー
 *  - エンコーダー: Layer 0 / 3 のみスクロール量 100、その他は 30
 *  - コンボ: 旧ファームと同じ zmk,combos（DYA Studio のコンボ一覧には出ない。
 *    Studio で追加したコンボは runtime combo として別枠で動く）
 */

/* pointing.h より先に定義する（pointing.h 側は #ifndef で既定値 10 を定義する） */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC_BASE 3
#define MAC_SYM 4
#define MAC_NAV 5
#define NUMBERS 6
#define BT_LAYER 7
#define MOUSE_MAC 8
#define MOUSE_WIN 9
#define SCROLL 10

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_layer_ESC {
            bindings = <&lt BT_LAYER ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            display-name = "TO_LAYER_0";
        };

        ime_macro: ime_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F13>;
            display-name = "IME_MACRO";
        };

        bt_win: bt_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&to 0>;
            display-name = "BT_WIN";
        };

        bt_mac: bt_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&to 0>, <&tog MAC_BASE>;
            display-name = "BT_MAC";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            display-name = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // DYA Studio: Runtime sensor rotate behaviors for encoder
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };

        rsr_scroll_ud: rsr_scroll_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        // Layer 0 / 3 用。実機で DYA Studio から ±100 に変更されていた値
        rsr_scroll_ud_fast: rsr_scroll_ud_fast {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc MOVE_Y(-100)>;
            ccw-binding = <&msc MOVE_Y(100)>;
        };

        rsr_scroll_lr: rsr_scroll_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_LEFT>;
            ccw-binding = <&msc SCRL_RIGHT>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        // ==========================================
        // Layer 0: Windows Base
        // ==========================================

        win_base {
            bindings = <
&kp Q             &kp W         &kp E     &kp R          &kp T                                                                  &kp Y        &kp U  &kp I      &lt SCROLL O  &lt MOUSE_WIN P
&kp A             &kp S         &kp D     &kp F          &kp G                                  &ime_macro                       &kp H        &kp J  &kp K      &kp L         &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C     &kp V          &kp B        &trans                     &trans                           &kp N        &kp M  &kp COMMA  &kp DOT       &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LALT  &kp BACKSPACE  &lt 1 SPACE  &lt_to_layer_0 2 LANG2     &lt_to_layer_0 2 LANGUAGE_1      &lt NUMBERS ENTER                            &kp LEFT_ALT
            >;

            sensor-bindings = <&rsr_scroll_ud_fast>;
        };

        // ==========================================
        // Layer 1: Windows Symbols
        // ==========================================

        win_symbols {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp POUND          &kp DOLLAR  &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp MINUS  &kp UNDERSCORE
&kp GRAVE        &kp TILDE    &kp DOUBLE_QUOTES  &kp SQT     &trans                  &trans   &mkp MB3   &mkp MB1       &mkp MB2      &kp EQUAL  &kp PLUS
&kp F1           &kp F2       &kp F3             &kp F4      &kp F5       &kp F11    &kp F12  &kp F6     &kp F7         &kp F8        &kp F9     &kp F10
&trans           &trans       &trans             &trans      &trans       &trans     &trans   &trans                                             &trans
            >;

            sensor-bindings = <&rsr_scroll_ud>;
        };

        // ==========================================
        // Layer 2: Windows Nav
        // ==========================================

        win_nav {
            bindings = <
&trans  &kp LC(LS(TAB))     &kp PRINTSCREEN         &kp LC(TAB)              &trans                                     &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans
&trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)     &kp LC(LG(LEFT_ARROW))   &kp LC(LG(RIGHT_ARROW))            &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &kp LEFT_SHIFT      &kp LG(LS(LEFT_ARROW))  &kp LG(LS(RIGHT_ARROW))  &trans                   &trans    &trans  &trans  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&trans  &trans              &trans                  &trans                   &trans                   &trans    &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        // ==========================================
        // Layer 3: Mac Base
        // ==========================================

        mac_base {
            bindings = <
&kp Q             &kp W      &kp E     &kp R          &kp T                                                            &kp Y        &kp U  &kp I      &lt SCROLL O  &lt MOUSE_MAC P
&kp A             &kp S      &kp D     &kp F          &kp G                              &ime_macro                    &kp H        &kp J  &kp K      &kp L         &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X      &kp C     &kp V          &kp B          &trans               &trans                        &kp N        &kp M  &kp COMMA  &kp DOT       &kp SLASH
&kp LGUI          &kp LCTRL  &kp LALT  &kp BACKSPACE  &lt MAC_SYM SPACE  &lt MAC_NAV LANG2  &lt MAC_NAV LANGUAGE_1       &lt NUMBERS ENTER                            &kp LALT
            >;

            sensor-bindings = <&rsr_scroll_ud_fast>;
        };

        // ==========================================
        // Layer 4: Mac Symbols
        // ==========================================

        mac_symbols {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp POUND          &kp DOLLAR  &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp MINUS  &kp UNDERSCORE
&kp GRAVE        &kp TILDE    &kp DOUBLE_QUOTES  &kp SQT     &trans                  &trans   &mkp MB3   &mkp MB1       &mkp MB2      &kp EQUAL  &kp PLUS
&kp F1           &kp F2       &kp F3             &kp F4      &kp F5       &kp F11    &kp F12  &kp F6     &kp F7         &kp F8        &kp F9     &kp F10
&trans           &trans       &trans             &trans      &trans       &trans     &trans   &trans                                             &trans
            >;

            sensor-bindings = <&rsr_scroll_ud>;
        };

        // ==========================================
        // Layer 5: Mac Nav
        // ==========================================

        mac_nav {
            bindings = <
&trans  &kp LC(LS(TAB))        &kp LG(LS(NUMBER_4))    &kp LC(TAB)          &trans                                     &trans  &kp HOME        &kp UP_ARROW    &kp END          &trans
&trans  &kp LC(LA(LEFT_ARROW)) &kp LC(LA(RIGHT_ARROW))  &kp LC(LEFT_ARROW)   &kp LC(RIGHT_ARROW)            &trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &kp LEFT_SHIFT         &trans                   &trans               &trans                &trans    &trans      &trans  &kp DELETE      &kp PAGE_UP     &kp PAGE_DOWN    &trans
&trans  &trans                 &trans                   &trans               &trans                &trans    &trans      &trans                                                   &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        // ==========================================
        // Layer 6: Numbers (共通 — Mac/Win両方より上)
        // ==========================================

        numbers {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4       &kp NUMBER_5                    &kp NUMBER_6  &kp NUMBER_7          &kp NUMBER_8           &kp NUMBER_9  &kp NUMBER_0
&trans        &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans                  &trans  &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans        &kp BACKSLASH
&trans        &trans        &trans            &trans             &trans        &trans    &trans  &trans        &trans                &trans                 &trans        &kp PIPE
&trans        &trans        &trans            &trans             &trans        &trans    &trans  &trans                                                                   &trans
            >;

            sensor-bindings = <&rsr_scroll_lr>;
        };

        // ==========================================
        // Layer 7: BT Layer
        // ==========================================

        bt_layer {
            bindings = <
&studio_unlock  &trans  &trans  &trans  &trans                         &bt_win       &bt_mac       &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans          &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans          &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans          &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_scroll_ud>;
        };

        // ==========================================
        // Layer 8: Mouse Mac
        // ==========================================

        mouse_mac {
            bindings = <
&kp ESC  &kp TAB   &kp LS(LG(N5))  &kp LS(LG(N4))  &kp LS(LG(N3))                                       &kp LG(W)  &kp LS(LG(T))      &mkp MB3  &kp LC(UP_ARROW)  &trans
&trans   &trans    &trans           &kp LC(LEFT)    &kp LC(RIGHT)                        &kp LG(W)      &kp LA(LG(LEFT))   &mkp MB1  &mkp MB2          &mkp MB3  &trans
&trans   &trans    &trans           &trans          &trans          &trans                &kp LG(X)     &kp LA(LG(RIGHT))  &mkp MB4  &mkp MB5          &trans    &trans
&trans   &trans    &trans           &trans          &kp LG(A)       &kp LG(Z)             &kp LG(C)     &kp LG(V)                                                &trans
            >;

            sensor-bindings = <&rsr_scroll_ud>;
        };

        // ==========================================
        // Layer 9: Mouse Win
        // ==========================================

        mouse_win {
            bindings = <
&kp ESC   &kp LG(TAB)  &trans    &trans    &kp DEL                                               &kp LC(W)          &kp LC(LS(T))     &mkp MB3  &mt LA(TAB) LA(TAB)  &trans
&trans    &mkp MB3  &mkp MB2  &mkp MB1  &trans                                &mt LCTRL W     &kp LC(LS(TAB))    &mkp MB1          &mkp MB2  &trans               &trans
&trans    &trans    &trans    &trans    &trans           &kp LC(A)            &mt LCTRL X     &kp LC(TAB)        &mkp MB4          &mkp MB5  &trans               &trans
&kp LALT  &trans    &trans    &kp LALT  &trans           &kp LC(Z)            &kp LC(C)       &kp LC(V)                                                            &trans
            >;

            sensor-bindings = <&rsr_scroll_ud>;
        };

        // ==========================================
        // Layer 10: Scroll
        // ==========================================

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_scroll_ud>;
        };
    };
};
