#include "mona2.dtsi"
/* mona2.dtsi の RC(row,col) 展開が終わった後に include する（mona2.dtsi の NOTE 参照） */
#include <input/processors/runtime-input-processor.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                    <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    /* DYA Studio の Trackball / 診断タブに対応した cormoran 版 PMW3610 ドライバー */
    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "cormoran,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        settings-id = "trackball";
    };
};

/* 実機で DYA Studio から保存されていたスクロール用プロセッサーの値を初期値として固定する
   (scale 1/21、X/Y 反転、Layer 10 のみ有効) */
&scroll_runtime_input_processor {
    scale-multiplier = <1>;
    scale-divisor = <21>;
    x-invert;
    y-invert;
    active-layers = <0x00000400>;
};

&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    input-processors =
        <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
        <&mouse_runtime_input_processor>;

    scroller {
        layers = <10>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_scroll_scaler 1 1>,
            <&scroll_runtime_input_processor>;
    };
};

/* DYA Studio のキーマップ プレビューにトラックボールとエンコーダーを表示する
   (見た目のみ。座標はキーの physical layout と同じ単位) */
/ {
    trackball_layout: trackball_layout {
        compatible = "cormoran,physical-layout-trackball";
        display-name = "Trackball";
        size = <180>;
        x = <910>;
        y = <300>;
        linked-device-identifiers = "mouse", "scroll";
        linked-subsystems = "cormoran_rip", "cormoran_rip";
    };

    rotary_encoders_layout: rotary_encoders_layout {
        compatible = "cormoran,physical-layout-rotary-encoders";
        display-name = "Rotary Encoder";
        encoders = <&encoder_left_layout>;
    };

    encoder_left_layout: encoder_left_layout {
        compatible = "cormoran,physical-layout-rotary-encoder";
        size = <80>;
        x = <510>;
        y = <10>;
    };
};
